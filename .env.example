# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit it.

# Required: HuggingFace access token for downloading gated models
# (Llama-2, Qwen, SANA, FLUX, etc.). Get one at:
#   https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional: OpenAI API key, required only if you run the GPT-4o-mini
# cross-validation judge (scripts/llm/concept_scoring_gpt4o.py).
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
